<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CKAN.LinuxGUI.DownloadStatisticsWindow"
        x:CompileBindings="False"
        Width="720"
        Height="540"
        MinWidth="640"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Title="Download Statistics"
        Background="#1B222A">
  <Window.Styles>
    <Style Selector="Button.dialog-action">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Background" Value="#24303B" />
      <Setter Property="BorderBrush" Value="#405061" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="#F3F7FC" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.dialog-action:pointerover">
      <Setter Property="Background" Value="#2E3C49" />
      <Setter Property="BorderBrush" Value="#5B7084" />
    </Style>
    <Style Selector="Button.dialog-action:pressed">
      <Setter Property="Background" Value="#1D2730" />
      <Setter Property="BorderBrush" Value="#6A7F94" />
    </Style>
    <Style Selector="Button.dialog-action:disabled">
      <Setter Property="Background" Value="#20262D" />
      <Setter Property="BorderBrush" Value="#303A44" />
      <Setter Property="Foreground" Value="#7B8794" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.download-table-header">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#F2F4F7" />
    </Style>
    <Style Selector="Border.download-header-separator">
      <Setter Property="Width" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,8" />
      <Setter Property="Background" Value="#2B4054" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto"
        Margin="20">
    <Border
            Background="#161B21"
            BorderBrush="#2B323C"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12">
      <Border Background="#111820"
              BorderBrush="#3D4E60"
              BorderThickness="1"
              CornerRadius="8"
              ClipToBounds="True">
      <Grid RowDefinitions="38,*">
        <Border Background="#16202A"
                BorderBrush="#2A3A4B"
                BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0">
          <Grid ColumnDefinitions="*,140">
            <TextBlock Classes="download-table-header"
                       Margin="12,0"
                       Text="Host" />
            <Border Grid.Column="1"
                    Classes="download-header-separator" />
            <TextBlock Grid.Column="1"
                       Classes="download-table-header"
                       Margin="12,0"
                       HorizontalAlignment="Right"
                       Text="Cached Size" />
          </Grid>
        </Border>
        <TextBlock Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Opacity="0.76"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ShowEmptyState}"
                   Text="{Binding SummaryText}" />
        <ScrollViewer Grid.Row="1"
                      Background="#111820"
                      IsVisible="{Binding ShowRows}">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#242B33"
                        BorderThickness="0,0,0,1"
                        Background="#111820"
                        Padding="12,10">
                  <Grid ColumnDefinitions="*,140">
                    <TextBlock Text="{Binding Host}" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               Opacity="0.78"
                               Text="{Binding SizeLabel}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
      </Border>
    </Border>

    <StackPanel Grid.Row="1"
                Margin="0,18,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="12">
      <Button Classes="dialog-action"
              Background="#20262D"
              BorderBrush="#39424E"
              Foreground="#F4F6F8"
              Click="CloseButton_OnClick"
              Content="Close" />
    </StackPanel>
  </Grid>
</Window>
