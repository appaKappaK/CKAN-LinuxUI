<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CKAN.LinuxGUI"
             x:Class="CKAN.LinuxGUI.CatalogSkeletonView"
             x:Name="CatalogSkeletonRoot"
             x:DataType="vm:MainWindowViewModel"
             IsHitTestVisible="False"
             MinHeight="0">
  <Border Background="#223345"
          BorderBrush="Transparent"
          BorderThickness="0"
          CornerRadius="0,10,10,10"
          Padding="9"
          ClipToBounds="True"
          MinHeight="0">
    <Grid RowDefinitions="Auto,*"
          MinHeight="0">
      <Grid ColumnDefinitions="*,Auto,Auto"
            Margin="0,0,0,8">
        <Border Background="#16202A"
                BorderBrush="#3D4E60"
                BorderThickness="1"
                CornerRadius="8"
                MinHeight="34"
                Padding="12,0">
          <TextBlock FontSize="12"
                     Foreground="#7F8B98"
                     VerticalAlignment="Center"
                     Text="Search by mod name, author, or description" />
        </Border>
        <Border Grid.Column="1"
                Classes="browser-chip"
                Background="#20262D"
                Margin="8,0,0,0"
                MinWidth="84"
                Padding="14,0"
                VerticalAlignment="Center">
          <TextBlock FontSize="12"
                     HorizontalAlignment="Stretch"
                     Opacity="0.7"
                     TextAlignment="Center"
                     VerticalAlignment="Center"
                     Text="{Binding #CatalogSkeletonRoot.CountLabel}" />
        </Border>
        <Border Grid.Column="2"
                Background="#161B21"
                BorderBrush="#34404C"
                BorderThickness="1"
                CornerRadius="8"
                Margin="8,0,0,0"
                Width="152"
                Height="34">
          <TextBlock FontSize="12"
                     HorizontalAlignment="Stretch"
                     Opacity="0.7"
                     TextAlignment="Center"
                     VerticalAlignment="Center"
                     Text="{Binding #CatalogSkeletonRoot.FiltersLabel}" />
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Background="#14191F"
              BorderBrush="#2B323C"
              BorderThickness="1"
              CornerRadius="8"
              Padding="8"
              ClipToBounds="True"
              MinHeight="0">
        <Grid RowDefinitions="Auto,*"
              MinHeight="0">
          <Grid Margin="1,1,17,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="{Binding BrowserMetadataColumnGridLength}" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1"
                       Classes="column-sort-header"
                       VerticalAlignment="Center"
                       Text="Name" />
            <Border Grid.Column="2"
                    BorderBrush="#2E3842"
                    BorderThickness="1,0,0,0"
                    Padding="10,0,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding BrowserDownloadsColumnGridLength}" />
                  <ColumnDefinition Width="{Binding BrowserReleasedColumnGridLength}" />
                  <ColumnDefinition Width="{Binding BrowserInstalledColumnGridLength}" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="column-sort-header"
                           VerticalAlignment="Center"
                           Text="Downloads" />
                <TextBlock Grid.Column="1"
                           Classes="column-sort-header"
                           Padding="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Released" />
                <TextBlock Grid.Column="2"
                           Classes="column-sort-header"
                           Padding="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Install Date" />
                <TextBlock Grid.Column="3"
                           Classes="column-sort-header"
                           Padding="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Version" />
              </Grid>
            </Border>
          </Grid>

          <ItemsControl Grid.Row="1"
                        Classes="catalog-skeleton-list"
                        ItemsSource="{Binding CatalogSkeletonRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CatalogSkeletonRow"
                            x:CompileBindings="False">
                <Border Background="#181D23"
                        BorderBrush="#202A33"
                        BorderThickness="0,0,0,1"
                        CornerRadius="5"
                        ClipToBounds="True"
                        Padding="0"
                        Margin="1,0,17,1"
                        HorizontalAlignment="Stretch"
                        MinHeight="47"
                        Opacity="{Binding Opacity}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="5" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="{Binding #CatalogSkeletonRoot.DataContext.BrowserMetadataColumnGridLength}" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding AccentBrush}"
                            CornerRadius="8,0,0,8" />
                    <StackPanel Grid.Column="1"
                                Margin="8,4,8,4"
                                VerticalAlignment="Center"
                                Spacing="7">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <Grid Grid.Column="0"
                              ColumnDefinitions="Auto,*">
                          <Border Background="#2A323C"
                                  CornerRadius="6"
                                  Height="15"
                                  Width="{Binding TitleWidth}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />
                          <Border Grid.Column="1"
                                  Background="#242B34"
                                  CornerRadius="6"
                                  Height="11"
                                  Width="{Binding AuthorWidth}"
                                  Margin="8,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding HasAuthor}" />
                        </Grid>
                        <StackPanel Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                          <Border Background="{Binding PrimaryBadgeBackground}"
                                  CornerRadius="999"
                                  Height="16"
                                  Width="{Binding PrimaryBadgeWidth}"
                                  Margin="0,0,6,0"
                                  IsVisible="{Binding HasPrimaryBadge}" />
                          <Border Background="#39424E"
                                  BorderBrush="#607286"
                                  BorderThickness="1"
                                  CornerRadius="999"
                                  Height="16"
                                  Width="52"
                                  Margin="0,0,6,0"
                                  IsVisible="{Binding HasCachedBadge}" />
                          <Border Background="{Binding SecondaryBadgeBackground}"
                                  BorderBrush="{Binding SecondaryBadgeBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="999"
                                  Height="16"
                                  Width="{Binding SecondaryBadgeWidth}"
                                  Margin="0,0,6,0"
                                  IsVisible="{Binding HasSecondaryBadge}" />
                          <Border Background="{Binding TertiaryBadgeBackground}"
                                  BorderBrush="{Binding TertiaryBadgeBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="999"
                                  Height="16"
                                  Width="{Binding TertiaryBadgeWidth}"
                                  Margin="0,0,6,0"
                                  IsVisible="{Binding HasTertiaryBadge}" />
                        </StackPanel>
                        <Border Grid.Column="2"
                                Margin="8,0,0,0"
                                Background="{Binding QueueBadgeBackground}"
                                BorderBrush="{Binding QueueBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Height="16"
                                Width="{Binding QueueBadgeWidth}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasQueueBadge}" />
                      </Grid>
                      <Border Background="#242B34"
                              CornerRadius="6"
                              Height="11"
                              Width="{Binding SummaryWidth}"
                              HorizontalAlignment="Left" />
                    </StackPanel>
                    <Grid Grid.Column="2"
                          ClipToBounds="True"
                          VerticalAlignment="Top"
                          Margin="0,1,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding #CatalogSkeletonRoot.DataContext.BrowserDownloadsColumnGridLength}" />
                        <ColumnDefinition Width="{Binding #CatalogSkeletonRoot.DataContext.BrowserReleasedColumnGridLength}" />
                        <ColumnDefinition Width="{Binding #CatalogSkeletonRoot.DataContext.BrowserInstalledColumnGridLength}" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Background="#2A323C"
                              CornerRadius="6"
                              Height="13"
                              Width="{Binding DownloadsWidth}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top" />
                      <Border Grid.Column="1"
                              Margin="10,0,0,0"
                              Background="#2A323C"
                              CornerRadius="6"
                              Height="13"
                              Width="{Binding ReleaseWidth}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top" />
                      <Border Grid.Column="2"
                              Margin="10,0,0,0"
                              Background="#2A323C"
                              CornerRadius="6"
                              Height="13"
                              Width="{Binding ReleaseWidth}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top" />
                      <Border Grid.Column="3"
                              BorderBrush="#24303B"
                              BorderThickness="1,0,0,0"
                              Padding="10,0,0,0"
                              ClipToBounds="True">
                        <StackPanel VerticalAlignment="Top"
                                    ClipToBounds="True"
                                    Spacing="4">
                          <Border Background="#2A323C"
                                  CornerRadius="6"
                                  Height="13"
                                  Width="{Binding VersionPrimaryWidth}"
                                  HorizontalAlignment="Left" />
                          <Border Background="#242B34"
                                  CornerRadius="6"
                                  Height="11"
                                  Width="{Binding VersionSecondaryWidth}"
                                  HorizontalAlignment="Left" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
