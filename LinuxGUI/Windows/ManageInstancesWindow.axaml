<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:CKAN.App.Models"
        x:Class="CKAN.LinuxGUI.ManageInstancesWindow"
        x:CompileBindings="False"
        Width="860"
        Height="440"
        MinWidth="760"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Title="Manage Game Instances"
        Background="#1B222A">
  <Window.Styles>
    <Style Selector="Button.dialog-action">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Background" Value="#24303B" />
      <Setter Property="BorderBrush" Value="#405061" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="#F3F7FC" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.dialog-action:pointerover">
      <Setter Property="Background" Value="#2E3C49" />
      <Setter Property="BorderBrush" Value="#5B7084" />
    </Style>
    <Style Selector="Button.dialog-action:pressed">
      <Setter Property="Background" Value="#1D2730" />
      <Setter Property="BorderBrush" Value="#6A7F94" />
    </Style>
    <Style Selector="Button.dialog-action:disabled">
      <Setter Property="Background" Value="#20262D" />
      <Setter Property="BorderBrush" Value="#303A44" />
      <Setter Property="Foreground" Value="#7B8794" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.instance-column-header">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#AEB9C5" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto"
        Margin="20">
    <Border
            Background="#161B21"
            BorderBrush="#2B323C"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock FontSize="14"
                       FontWeight="SemiBold"
                       Text="Registered Instances" />
            <TextBlock FontSize="12"
                       Opacity="0.68"
                       TextWrapping="Wrap"
                       Text="Management changes are saved immediately. Select another instance to open it in the mod browser." />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="10">
            <Button Classes="dialog-action"
                    Click="AddInstanceButton_OnClick"
                    IsEnabled="{Binding CanManageInstances}"
                    Content="Add Folder" />
            <Button Classes="dialog-action"
                    Click="ImportSteamButton_OnClick"
                    IsEnabled="{Binding CanImportSteam}"
                    Content="Import Steam" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Background="#111820"
                BorderBrush="#3D4E60"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
          <Grid RowDefinitions="34,*">
            <Border Background="#16202A"
                    BorderBrush="#2A3A4B"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
              <Grid ColumnDefinitions="2*,74,82,78,2.6*"
                    Margin="10,0,10,0">
                <TextBlock Classes="instance-column-header"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Text="Name" />
                <Border Grid.Column="1"
                        Width="1"
                        Margin="0,8"
                        HorizontalAlignment="Left"
                        Background="#2B4054" />
                <TextBlock Grid.Column="1"
                           Classes="instance-column-header"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Text="Game" />
                <Border Grid.Column="2"
                        Width="1"
                        Margin="0,8"
                        HorizontalAlignment="Left"
                        Background="#2B4054" />
                <TextBlock Grid.Column="2"
                           Classes="instance-column-header"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Text="Version" />
                <Border Grid.Column="3"
                        Width="1"
                        Margin="0,8"
                        HorizontalAlignment="Left"
                        Background="#2B4054" />
                <TextBlock Grid.Column="3"
                           Classes="instance-column-header"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Text="Hours" />
                <Border Grid.Column="4"
                        Width="1"
                        Margin="0,8"
                        HorizontalAlignment="Left"
                        Background="#2B4054" />
                <TextBlock Grid.Column="4"
                           Classes="instance-column-header"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Text="Path" />
              </Grid>
            </Border>

            <ListBox x:Name="InstancesListBox"
                     Grid.Row="1"
                     Classes="utility-list"
                     Background="#111820"
                     BorderThickness="0"
                     ItemsSource="{Binding Instances}"
                     SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="models:InstanceSummary">
                  <Border Classes="utility-list-row">
                    <Grid ColumnDefinitions="2*,74,82,78,2.6*"
                          MinHeight="32">
                      <Grid ColumnDefinitions="*,52,52"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Name}" />
                        <TextBlock Grid.Column="1"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#AEB9C5"
                                   Text="Current"
                                   IsVisible="{Binding IsCurrent}" />
                        <TextBlock Grid.Column="2"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#AEB9C5"
                                   Text="Default"
                                   IsVisible="{Binding IsDefault}" />
                      </Grid>
                      <TextBlock Grid.Column="1"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding GameName}" />
                      <TextBlock Grid.Column="2"
                                 VerticalAlignment="Center"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding VersionText}" />
                      <TextBlock Grid.Column="3"
                                 VerticalAlignment="Center"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding PlayTimeValue}" />
                      <TextBlock Grid.Column="4"
                                 VerticalAlignment="Center"
                                 Opacity="0.72"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding GameDir}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Margin="0,18,0,0"
          ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal"
                  Spacing="12"
                  VerticalAlignment="Center">
        <CheckBox VerticalAlignment="Center"
                  Content="Set as default"
                  Click="SetDefaultCheckBox_OnClick"
                  IsEnabled="{Binding CanSetDefault}"
                  IsChecked="{Binding IsSelectedDefault, Mode=OneWay}" />
        <Button Classes="dialog-action"
                Click="ForgetButton_OnClick"
                IsEnabled="{Binding CanForgetSelection}"
                Content="Forget" />
        <Button Classes="dialog-action"
                Click="RenameButton_OnClick"
                IsEnabled="{Binding CanRenameSelection}"
                Content="Rename" />
      </StackPanel>

      <TextBlock Grid.Column="1"
                 Margin="18,0"
                 VerticalAlignment="Center"
                 FontSize="12"
                 Opacity="0.72"
                 TextTrimming="CharacterEllipsis"
                 IsVisible="{Binding ShowFooterText}"
                 Text="{Binding FooterText}" />

      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="10">
        <Button Classes="dialog-action"
                Background="#355779"
                BorderBrush="#5A86B4"
                Foreground="#F4F6F8"
                Click="UseSelectedButton_OnClick"
                IsVisible="{Binding CanUseSelection}"
                Content="Open Install" />
        <Button Classes="dialog-action"
                Background="#20262D"
                BorderBrush="#39424E"
                Foreground="#F4F6F8"
                Click="CloseButton_OnClick"
                Content="Done" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
